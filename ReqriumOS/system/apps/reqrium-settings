    def page_about(self):
        top = Adw.PreferencesGroup()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=12,
                      margin_bottom=12, halign=Gtk.Align.CENTER)
        box.append(ui.logo_widget(112))
        box.append(Gtk.Label(label="ReqriumOS", css_classes=["hero-title"]))
        box.append(Gtk.Label(label="Liquid glass, on Arch Linux", css_classes=["hero-sub"]))
        top.add(box)

        info = Adw.PreferencesGroup(title="This computer")
        for title, value in system_info():
            r = Adw.ActionRow(title=title, subtitle=value)
            r.add_css_class("property")
