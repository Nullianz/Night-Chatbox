        up = Adw.PreferencesGroup(title="Updates")
        up.add(row_with_button(
            "Update everything", "System packages, AUR apps and Flatpak apps", "Update",
            lambda: ui.in_terminal("Updating ReqriumOS",
                                   "sudo pacman -Syu; command -v paru >/dev/null && paru -Sua; "
                                   "flatpak update -y")))
        up.add(row_with_button("Welcome tour", "Show the welcome app again", "Open",
                               lambda: ui.run(["reqrium-welcome"])))
