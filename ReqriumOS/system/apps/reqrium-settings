def system_info():
    info = []
    try:
        osr = dict(line.strip().split("=", 1) for line in open("/etc/os-release") if "=" in line)
        info.append(("System", osr.get("PRETTY_NAME", "ReqriumOS").strip('"')))
    except OSError:
        info.append(("System", "ReqriumOS"))
    info.append(("Computer name", platform.node()))
    info.append(("Kernel", platform.release()))
    try:
        cpu = next(line.split(":", 1)[1].strip() for line in open("/proc/cpuinfo")
                   if line.startswith("model name"))
        info.append(("Processor", f"{cpu} ({os.cpu_count()} threads)"))
    except (OSError, StopIteration):
        pass
    try:
        kb = int(next(line.split()[1] for line in open("/proc/meminfo")
                      if line.startswith("MemTotal")))
        info.append(("Memory", f"{kb / 1024 / 1024:.1f} GB"))
    except (OSError, StopIteration, ValueError):
        pass
    gpus = [line.split(": ", 1)[-1] for line in ui.run(["lspci"], wait=True).splitlines()
            if re.search(r"VGA|3D|Display", line)]
    if gpus:
        info.append(("Graphics", "; ".join(gpus)))
    du = shutil.disk_usage("/")
    info.append(("Disk", f"{du.used / 1e9:.0f} GB used of {du.total / 1e9:.0f} GB"))
    return info


class SettingsApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.page = None

    def do_command_line(self, cmd):
        args = cmd.get_arguments()[1:]
        self.page = args[0] if args else None
        self.activate()
        return 0

    def do_activate(self):
        ui.setup_style()
        win = self.props.active_window or SettingsWindow(self, self.page)
        win.present()


if __name__ == "__main__":
    sys.exit(SettingsApp().run(sys.argv))
