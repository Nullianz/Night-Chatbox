# ReqriumOS boot splash.

W = Window.GetWidth();
H = Window.GetHeight();
Window.SetBackgroundTopColor(0.04, 0.04, 0.12);
Window.SetBackgroundBottomColor(0.02, 0.03, 0.08);

bg = Image("background.png");
bg_sprite = Sprite(bg.Scale(W, H));
bg_sprite.SetZ(-100);

logo = Image("logo.png");
size = Math.Int(H * 0.22);
logo = logo.Scale(size, size);
logo_sprite = Sprite(logo);
logo_sprite.SetX(W / 2 - size / 2);
logo_sprite.SetY(H / 2 - size / 2 - H * 0.04);

name = Image.Text("ReqriumOS", 1, 1, 1, 0.9, "Inter Bold 26");
name_sprite = Sprite(name);
name_sprite.SetX(W / 2 - name.GetWidth() / 2);
name_sprite.SetY(H / 2 + size / 2 + H * 0.02);

# three dots that ripple while the system starts
dot_image = Image("dot.png");
for (i = 0; i < 3; i++) {
  dot[i] = Sprite(dot_image);
  dot[i].SetX(W / 2 - 32 + i * 24);
  dot[i].SetY(H / 2 + size / 2 + H * 0.08);
}

t = 0;
fun refresh() {
  t++;
  # the logo "breathes" like liquid glass
  logo_sprite.SetOpacity(0.70 + 0.30 * Math.Sin(t / 18));
  for (i = 0; i < 3; i++)
    dot[i].SetOpacity(0.25 + 0.75 * Math.Abs(Math.Sin(t / 14 - i * 0.6)));
}
Plymouth.SetRefreshFunction(refresh);

# password prompt (e.g. encrypted disks)
# Sprites must live in "global." or Plymouth frees them when the function returns.
global.pw_label = Sprite();
global.pw_box = Sprite();
fun display_password(prompt, bullets) {
  text = "Drive password";
  if (prompt) text = prompt;
  dots = "";
  for (i = 0; i < bullets; i++) dots += "*";
  if (bullets == 0) dots = " ";
  label = Image.Text(text, 1, 1, 1, 0.85, "Sans 13");
  global.pw_label.SetImage(label);
  global.pw_label.SetX(W / 2 - label.GetWidth() / 2);
  global.pw_label.SetY(H * 0.74);
  global.pw_label.SetOpacity(1);
  field = Image.Text(dots, 0.77, 0.93, 1, 1, "Sans Bold 20");
  global.pw_box.SetImage(field);
  global.pw_box.SetX(W / 2 - field.GetWidth() / 2);
  global.pw_box.SetY(H * 0.74 + label.GetHeight() + 10);
  global.pw_box.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(display_password);
fun display_normal() {
  global.pw_label.SetOpacity(0);
  global.pw_box.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal);
