// ReqriumOS glass dock (a second Waybar at the bottom of the screen)
{
    "name": "dock",
    "layer": "top",
    "position": "bottom",
    "height": 62,
    "margin-bottom": 12,
    "exclusive": true,
    "spacing": 4,

    "modules-center": [
        "custom/apps",
        "custom/firefox", "custom/files", "custom/terminal", "custom/store", "custom/monitor", "custom/editor", "custom/settings",
        "wlr/taskbar"
    ],

    "custom/apps":     { "format": "󰀻", "tooltip-format": "All apps",
                         "on-click": "rofi -show drun -theme ~/.config/rofi/grid.rasi" },
    "custom/firefox":  { "format": "󰈹", "tooltip-format": "Firefox",       "on-click": "firefox" },
    "custom/files":    { "format": "󰉋", "tooltip-format": "Files",         "on-click": "thunar" },
    "custom/terminal": { "format": "", "tooltip-format": "Terminal",      "on-click": "kitty" },
    "custom/store":    { "format": "󰏓", "tooltip-format": "App Store",     "on-click": "gnome-software" },
    "custom/monitor":  { "format": "󰓅", "tooltip-format": "Mission Center", "on-click": "missioncenter" },
    "custom/editor":   { "format": "󰷈", "tooltip-format": "Text Editor",   "on-click": "gnome-text-editor" },
    "custom/settings": { "format": "", "tooltip-format": "Settings",      "on-click": "reqrium-settings" },

    // icons of the apps that are open right now
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 30,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "ignore-list": ["Install ReqriumOS"]
    }
}
