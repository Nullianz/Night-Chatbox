// ReqriumOS floating glass panel
{
    "layer": "top",
    "position": "top",
    "height": 42,
    "margin-top": 10,
    "margin-left": 14,
    "margin-right": 14,
    "spacing": 6,

    "modules-left":   ["custom/logo", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right":  ["mpris", "tray", "pulseaudio", "network", "battery", "custom/power"],

    "custom/logo": {
        "format": "◈",
        "tooltip-format": "ReqriumOS",
        "on-click": "rofi -show drun -theme ~/.config/rofi/glass.rasi"
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": { "active": "●", "default": "○", "empty": "·" },
        "persistent-workspaces": { "*": 5 },
        "on-scroll-up": "hyprctl dispatch workspace e-1",
        "on-scroll-down": "hyprctl dispatch workspace e+1"
    },

    "hyprland/window": {
        "max-length": 40,
        "separate-outputs": true
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%A, %d %B  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<span color='#7dd3fc'><b>{}</b></span>"
            }
        }
    },

    "mpris": {
        "format": "♪ {title}",
        "format-paused": "⏸ {title}",
        "max-length": 30
    },

    "tray": { "icon-size": 16, "spacing": 8 },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "on-click": "pavucontrol",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
    },

    "network": {
        "format-wifi": "󰖩 {essid}",
        "format-ethernet": "󰈀 wired",
        "format-disconnected": "󰖪 offline",
        "tooltip-format": "{ipaddr} via {gwaddr}",
        "on-click": "nm-connection-editor"
    },

    "battery": {
        "states": { "warning": 25, "critical": 12 },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
    },

    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Power",
        "on-click": "~/.config/reqrium/scripts/powermenu.sh"
    }
}
