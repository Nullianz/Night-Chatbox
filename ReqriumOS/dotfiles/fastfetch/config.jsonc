// ReqriumOS system info: run `fastfetch`
{
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": { "1": "38;2;196;181;253", "2": "38;2;125;211;252", "3": "38;2;240;171;252" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;125;211;252" }
  },
  "modules": [
    { "type": "title", "color": { "user": "38;2;196;181;253", "host": "38;2;125;211;252" } },
    "separator",
    { "type": "os",       "key": "◈ OS" },
    { "type": "kernel",   "key": "◈ Kernel" },
    { "type": "uptime",   "key": "◈ Uptime" },
    { "type": "packages", "key": "◈ Packages" },
    { "type": "wm",       "key": "◈ Desktop" },
    { "type": "terminal", "key": "◈ Terminal" },
    { "type": "cpu",      "key": "◈ CPU" },
    { "type": "gpu",      "key": "◈ GPU" },
    { "type": "memory",   "key": "◈ Memory" },
    { "type": "disk",     "key": "◈ Disk" },
    "break",
    "colors"
  ]
}
