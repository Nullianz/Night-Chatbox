/* ReqriumOS app grid: a full-screen glass "launchpad" (SUPER+A, or the dock button). */
@import "glass.rasi"

configuration { show-icons: true; drun-display-format: "{name}"; }

window {
    fullscreen: true;
    width: 100%;
    border: 0;
    border-radius: 0;
    padding: 8% 14%;
    background-color: rgba(11, 10, 31, 38%);
}

mainbox { spacing: 34px; children: [ inputbar, listview ]; }

inputbar {
    width: 420px;
    margin: 0 30%;
    padding: 14px 22px;
    border-radius: 999px;
    background-color: rgba(255, 255, 255, 12%);
    border: 1px;
    border-color: rgba(255, 255, 255, 22%);
}

listview {
    columns: 6;
    lines: 4;
    spacing: 18px;
    flow: horizontal;
    fixed-columns: true;
}

element {
    orientation: vertical;
    padding: 18px 8px;
    spacing: 10px;
    border-radius: 24px;
}
element selected.normal {
    background-color: rgba(255, 255, 255, 16%);
    border: 1px;
    border-color: rgba(125, 211, 252, 55%);
}
element-icon { size: 64px; horizontal-align: 0.5; }
element-text { horizontal-align: 0.5; font: "Inter 11"; }
