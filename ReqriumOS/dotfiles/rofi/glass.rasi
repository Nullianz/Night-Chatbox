/* ReqriumOS glass app launcher (Hyprland blurs it via layerrule). */

configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "";
    drun-display-format: "{name}";
}

* {
    font: "Inter 12";
    glass:    rgba(255, 255, 255, 9%);
    glass-hi: rgba(255, 255, 255, 22%);
    edge:     rgba(255, 255, 255, 25%);
    text:     rgba(255, 255, 255, 92%);
    dim:      rgba(255, 255, 255, 55%);
    accent:   #7dd3fc;
    background-color: transparent;
    text-color: @text;
}

window {
    width: 620px;
    border: 1px;
    border-color: @edge;
    border-radius: 26px;
    background-color: rgba(30, 24, 70, 28%);
    padding: 18px;
}

mainbox { spacing: 14px; children: [ inputbar, listview ]; }

inputbar {
    padding: 12px 18px;
    border-radius: 18px;
    background-color: @glass;
    border: 1px;
    border-color: rgba(255, 255, 255, 12%);
    children: [ prompt, entry ];
    spacing: 10px;
}
prompt { text-color: @accent; }
entry  { placeholder: "Search apps…"; placeholder-color: @dim; }

listview {
    lines: 7;
    columns: 1;
    spacing: 4px;
    fixed-height: true;
    scrollbar: false;
}

element {
    padding: 10px 14px;
    border-radius: 14px;
    spacing: 12px;
}
element normal.normal, element alternate.normal { background-color: transparent; }
element selected.normal {
    background-color: @glass-hi;
    border: 1px;
    border-color: rgba(125, 211, 252, 45%);
}
element-icon { size: 26px; }
element-text { vertical-align: 0.5; }
