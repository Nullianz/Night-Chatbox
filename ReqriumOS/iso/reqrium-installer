#!/usr/bin/env bash
# ReqriumOS disk installer. Run as root from the ReqriumOS live ISO.
#
# Asks a few questions, then: erases the chosen drive, creates an EFI (or
# BIOS boot) partition plus a btrfs root with @, @home, @snapshots, @log
# and @cache subvolumes, installs Arch + ReqriumOS, sets up the user,
# snapshots and the GRUB bootloader.
#
# Unattended install (no questions): set REQRIUM_AUTO=1 and
#   DISK=/dev/sdX  USERNAME=alex  PASSWORD=...  [HOSTNAME_=reqrium-pc]
#   [TIMEZONE=UTC] [LOCALE="en_US.UTF-8 UTF-8"] [KEYMAP=us] [EXTRAS=gaming,office]
#   [ENCRYPT=yes [CRYPT_PASS=...]]   (CRYPT_PASS defaults to PASSWORD)
# then run:  sudo -E reqrium-installer
set -euo pipefail

SRC=/usr/share/reqriumos
LOG=/tmp/reqrium-install.log
MNT=/mnt
SKY=117; VIOLET=183; RED=210

banner() {
  clear
  gum style --border rounded --border-foreground "$VIOLET" --padding "1 4" --margin "1 2" \
    --align center --bold --foreground "$SKY" "◈  ReqriumOS Installer" \
    "$(gum style --foreground 250 --bold=false "${1:-Liquid glass, on your drive}")"
}
step() { gum style --foreground "$SKY" --bold "◈ $*"; }
fail() { gum style --foreground "$RED" --bold "✗ $*"; exit 1; }
ask()  { gum input --header "$1" --header.foreground "$SKY" --placeholder "$2" --value "${3:-}" --width 50; }

# Re-run through sudo when started as a normal user
[ "$(id -u)" -eq 0 ] || exec sudo "$0" "$@"
command -v gum >/dev/null || { echo "gum is missing; this must run from the ReqriumOS ISO." >&2; exit 1; }
[ -d "$SRC" ] || fail "ReqriumOS files missing from $SRC."

if [ -d /sys/firmware/efi ]; then BOOT_MODE=uefi; else BOOT_MODE=bios; fi

# Internet check (Arch website, or Arch's main package mirror)
online() {
  curl -fs --max-time 6 -o /dev/null https://archlinux.org ||
    curl -fs --max-time 6 -o /dev/null https://geo.mirror.pkgbuild.com/
}

if [ -n "${REQRIUM_AUTO:-}" ]; then
  # ---------------------------------------------------------- unattended ---
  : "${DISK:?set DISK}" "${USERNAME:?set USERNAME}" "${PASSWORD:?set PASSWORD}"
  [ -b "$DISK" ] || fail "$DISK is not a drive."
  PASS1="$PASSWORD"
  HOSTNAME_="${HOSTNAME_:-reqrium-pc}"; TIMEZONE="${TIMEZONE:-UTC}"
  LOCALE="${LOCALE:-en_US.UTF-8 UTF-8}"; KEYMAP="${KEYMAP:-us}"; EXTRAS="${EXTRAS:-}"
  ENCRYPT="${ENCRYPT:-no}"
  [ "$ENCRYPT" = yes ] && CRYPT_PASS="${CRYPT_PASS:-$PASSWORD}"
  online || fail "No internet connection."
  step "Unattended install to $DISK (user $USERNAME, encrypted: $ENCRYPT)"
else
# --------------------------------------------------------------- internet ---
banner "Step 1 of 6 · Internet"
until online; do
  gum style --foreground "$RED" "No internet connection found."
  choice="$(gum choose "Set up Wi-Fi" "Try again" "Quit")"
  case "$choice" in
    "Set up Wi-Fi")
      gum style --foreground 250 "In iwctl type:  station wlan0 connect YOUR-WIFI-NAME   then: exit"
      iwctl || true ;;
    "Quit") exit 1 ;;
  esac
done
step "Connected"
timedatectl set-ntp true 2>/dev/null || true

# ------------------------------------------------------------------ drive ---
banner "Step 2 of 6 · Choose a drive"
bootsrc="$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null || true)"
livedisk=""
if [ -n "$bootsrc" ]; then
  bootsrc="$(realpath "$bootsrc")"
  parent="$(lsblk -no PKNAME "$bootsrc" 2>/dev/null | head -n1)"
  livedisk="/dev/${parent:-$(basename "$bootsrc")}"
fi

disks=()
while read -r name size type model; do
  [ "$type" = disk ] || continue
  [[ "$name" == /dev/zram* || "$name" == /dev/loop* ]] && continue
  [ "$name" = "$livedisk" ] && continue
  disks+=("$name  ($size)  ${model//\\x20/ }")
done < <(lsblk -dpnro NAME,SIZE,TYPE,MODEL)
[ "${#disks[@]}" -gt 0 ] || fail "No drives found to install to."

DISK="$(gum choose --header "Install ReqriumOS on which drive?" --header.foreground "$SKY" "${disks[@]}" | awk '{print $1}')"
[ -n "$DISK" ] || exit 1
bytes="$(lsblk -dbno SIZE "$DISK")"
if [ "$bytes" -lt $((20 * 1024 ** 3)) ]; then
  gum confirm "That drive is smaller than 20 GB. Continue anyway?" || exit 1
fi

# ------------------------------------------------------------------ you ---
banner "Step 3 of 6 · Create your account"
gum style --foreground 250 --margin "0 2" \
  "Sign up for this computer. You'll use this account to log in." \
  "Your password is also your sudo (administrator) password: you type it" \
  "to install apps, change system settings, or run sudo in the terminal." \
  "There is no separate root password."
echo
while :; do
  USERNAME="$(ask "Username (lowercase)" "e.g. alex")"
  [[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] && [ "$USERNAME" != root ] && break
  gum style --foreground "$RED" "Use lowercase letters, numbers, - or _, starting with a letter."
done
while :; do
  PASS1="$(gum input --password --header "Password (also your sudo password, at least 6 characters)" --header.foreground "$SKY" --width 60)"
  if [ "${#PASS1}" -lt 6 ]; then
    gum style --foreground "$RED" "That password is too short. Use at least 6 characters."
    continue
  fi
  PASS2="$(gum input --password --header "Confirm password" --header.foreground "$SKY" --width 60)"
  [ "$PASS1" = "$PASS2" ] && break
  gum style --foreground "$RED" "The passwords did not match. Try again."
done
while :; do
  HOSTNAME_="$(ask "Computer name" "e.g. reqrium-pc" "reqrium-pc")"
  [[ "$HOSTNAME_" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$ ]] && break
  gum style --foreground "$RED" "Use letters, numbers and dashes only."
done

echo
gum style --foreground "$SKY" --bold "Protect your drive"
gum style --foreground 250 \
  "Encryption scrambles everything on the drive, so nobody can read your files" \
  "if the computer is lost or stolen. You type a password each time it starts."
ENCRYPT=no
if gum confirm --default=false --affirmative "Encrypt" --negative "No thanks" \
     "Encrypt the whole drive? (recommended for laptops)"; then
  ENCRYPT=yes
  if gum confirm --affirmative "Same password" --negative "Separate password" \
       "Unlock the drive with your account password?"; then
    CRYPT_PASS="$PASS1"
  else
    while :; do
      CRYPT_PASS="$(gum input --password --header "Drive password (at least 8 characters)" --header.foreground "$SKY" --width 60)"
      if [ "${#CRYPT_PASS}" -lt 8 ]; then
        gum style --foreground "$RED" "Use at least 8 characters."; continue
      fi
      CP2="$(gum input --password --header "Confirm drive password" --header.foreground "$SKY" --width 60)"
      [ "$CRYPT_PASS" = "$CP2" ] && break
      gum style --foreground "$RED" "The passwords did not match. Try again."
    done
    unset CP2
  fi
fi

# ----------------------------------------------------------------- region ---
banner "Step 4 of 6 · Region"
TIMEZONE="$(timedatectl list-timezones | gum filter --header "Time zone (type to search)" \
  --header.foreground "$SKY" --placeholder "e.g. London, New_York, Tokyo" --height 12)"
[ -n "$TIMEZONE" ] || TIMEZONE=UTC
LOCALE="$(grep -E 'UTF-8$' /usr/share/i18n/SUPPORTED | gum filter --header "Language" \
  --header.foreground "$SKY" --value "en_US.UTF-8" --height 12)"
[ -n "$LOCALE" ] || LOCALE="en_US.UTF-8 UTF-8"
KEYMAP="$(localectl list-x11-keymap-layouts 2>/dev/null | gum filter --header "Keyboard layout" \
  --header.foreground "$SKY" --value "us" --height 12)"
[ -n "$KEYMAP" ] || KEYMAP=us

# ----------------------------------------------------------------- extras ---
banner "Step 5 of 6 · Extras"
gum style --foreground 250 "Space selects, Enter continues. You can skip all of them."
picked="$(gum choose --no-limit --header "Add any of these?" --header.foreground "$SKY" \
  "gaming    Steam, GameMode, MangoHud" \
  "office    LibreOffice" \
  "printing  Printer support (CUPS)" \
  "dev       VS Code, Python, Node.js" || true)"
EXTRAS="$(awk '{print $1}' <<<"$picked" | paste -sd, -)"

# ---------------------------------------------------------------- confirm ---
banner "Step 6 of 6 · Ready"
gum style --border rounded --border-foreground "$SKY" --padding "1 3" \
  "Drive:     $DISK  (EVERYTHING ON IT WILL BE ERASED)" \
  "Account:   $USERNAME  (administrator; sudo uses your password)" \
  "Computer:  $HOSTNAME_" \
  "Time zone: $TIMEZONE" \
  "Language:  ${LOCALE%% *}" \
  "Keyboard:  $KEYMAP" \
  "Extras:    ${EXTRAS:-none}" \
  "Encrypted: $ENCRYPT" \
  "Boot mode: ${BOOT_MODE^^}"
gum confirm --default=false --affirmative "Erase and install" --negative "Cancel" \
  "Erase $DISK and install ReqriumOS?" || { echo "Cancelled. Nothing was changed."; exit 0; }

fi   # end of questions

# ================================================================= install ===
exec > >(tee -a "$LOG") 2>&1
trap 'gum style --foreground "$RED" --bold "✗ Install failed. Details are in $LOG"' ERR

part() { if [[ "$1" =~ [0-9]$ ]]; then echo "${1}p$2"; else echo "$1$2"; fi; }
P1="$(part "$DISK" 1)"; P2="$(part "$DISK" 2)"

step "Partitioning $DISK"
umount -R "$MNT" 2>/dev/null || true
swapoff -a 2>/dev/null || true
wipefs -af "$DISK"
sgdisk --zap-all "$DISK"
# Layouts:
#   UEFI:            p1 EFI (1G)  p2 root
#   BIOS:            p1 BIOS boot (1M)  p2 root
#   BIOS, encrypted: p1 BIOS boot (1M)  p2 /boot ext4 (1G)  p3 encrypted root
BOOTPART=""
if [ "$BOOT_MODE" = uefi ]; then
  sgdisk -n1:0:+1G -t1:ef00 -c1:EFI -n2:0:0 -t2:8300 -c2:ReqriumOS "$DISK"
  ROOTPART="$P2"
elif [ "$ENCRYPT" = yes ]; then
  sgdisk -n1:0:+1M -t1:ef02 -c1:BIOSBOOT -n2:0:+1G -t2:8300 -c2:BOOT \
         -n3:0:0 -t3:8309 -c3:ReqriumOS "$DISK"
  BOOTPART="$P2"; ROOTPART="$(part "$DISK" 3)"
else
  sgdisk -n1:0:+1M -t1:ef02 -c1:BIOSBOOT -n2:0:0 -t2:8300 -c2:ReqriumOS "$DISK"
  ROOTPART="$P2"
fi
partprobe "$DISK" 2>/dev/null || true
udevadm settle

step "Formatting"
[ "$BOOT_MODE" = uefi ] && mkfs.fat -F32 -n EFI "$P1"
[ -n "$BOOTPART" ] && mkfs.ext4 -F -L BOOT "$BOOTPART"
ROOTDEV="$ROOTPART"
if [ "$ENCRYPT" = yes ]; then
  step "Encrypting the drive (this takes a few seconds)"
  printf '%s' "$CRYPT_PASS" | cryptsetup luksFormat --type luks2 --pbkdf argon2id \
    --label ReqriumOS-crypt --batch-mode "$ROOTPART" -
  printf '%s' "$CRYPT_PASS" | cryptsetup open "$ROOTPART" cryptroot -
  unset CRYPT_PASS
  ROOTDEV=/dev/mapper/cryptroot
fi
mkfs.btrfs -f -L ReqriumOS "$ROOTDEV"

mount "$ROOTDEV" "$MNT"
for sv in @ @home @snapshots @log @cache; do btrfs subvolume create "$MNT/$sv"; done
umount "$MNT"

OPTS=noatime,compress=zstd:1
mount -o "$OPTS,subvol=@" "$ROOTDEV" "$MNT"
mkdir -p "$MNT"/{home,.snapshots,var/log,var/cache/pacman/pkg}
mount -o "$OPTS,subvol=@home"      "$ROOTDEV" "$MNT/home"
mount -o "$OPTS,subvol=@snapshots" "$ROOTDEV" "$MNT/.snapshots"
mount -o "$OPTS,subvol=@log"       "$ROOTDEV" "$MNT/var/log"
mount -o "$OPTS,subvol=@cache"     "$ROOTDEV" "$MNT/var/cache/pacman/pkg"
# Without encryption GRUB reads /boot from btrfs and the EFI partition sits
# at /efi. With encryption /boot must stay readable before unlocking, so it
# lives on the EFI partition (UEFI) or its own small partition (BIOS).
EFIDIR=/efi
if [ "$BOOT_MODE" = uefi ] && [ "$ENCRYPT" = yes ]; then
  EFIDIR=/boot
fi
if [ "$BOOT_MODE" = uefi ]; then
  mkdir -p "$MNT$EFIDIR"
  mount "$P1" "$MNT$EFIDIR"
elif [ -n "$BOOTPART" ]; then
  mkdir -p "$MNT/boot"
  mount "$BOOTPART" "$MNT/boot"
fi

step "Preparing package signing keys"
# The live USB normally sets these up at boot (pacman-init.service), but
# that waits for the clock to sync over the internet and can still be
# queued or running. If the Arch keys aren't there yet, do it now.
if ! pacman-key --list-keys 2>/dev/null | grep -q "@archlinux.org"; then
  systemctl stop pacman-init.service 2>/dev/null || true
  pacman-key --init
  pacman-key --populate archlinux
fi

step "Installing the base system"
base=(base linux linux-firmware sof-firmware btrfs-progs grub sudo nano networkmanager pciutils git)
[ "$BOOT_MODE" = uefi ] && base+=(efibootmgr)
[ "$ENCRYPT" = yes ] && base+=(cryptsetup)
pacstrap -K "$MNT" "${base[@]}"
genfstab -U "$MNT" >> "$MNT/etc/fstab"

step "Setting region, language and computer name"
arch-chroot "$MNT" ln -sf "/usr/share/zoneinfo/$TIMEZONE" /etc/localtime
arch-chroot "$MNT" hwclock --systohc
{ echo "$LOCALE"; [ "$LOCALE" = "en_US.UTF-8 UTF-8" ] || echo "en_US.UTF-8 UTF-8"; } >> "$MNT/etc/locale.gen"
arch-chroot "$MNT" locale-gen
echo "LANG=${LOCALE%% *}" > "$MNT/etc/locale.conf"
if localectl list-keymaps 2>/dev/null | grep -qx "$KEYMAP"; then
  echo "KEYMAP=$KEYMAP" > "$MNT/etc/vconsole.conf"
else
  echo "KEYMAP=us" > "$MNT/etc/vconsole.conf"
fi
echo "$HOSTNAME_" > "$MNT/etc/hostname"
cat > "$MNT/etc/hosts" <<EOF
127.0.0.1   localhost
::1         localhost
127.0.1.1   $HOSTNAME_.localdomain $HOSTNAME_
EOF

step "Creating account $USERNAME"
arch-chroot "$MNT" useradd -m -G wheel -s /bin/bash "$USERNAME"
printf '%s:%s\n' "$USERNAME" "$PASS1" | arch-chroot "$MNT" chpasswd
arch-chroot "$MNT" passwd -l root   # use sudo instead of a root login
echo '%wheel ALL=(ALL:ALL) ALL' > "$MNT/etc/sudoers.d/10-wheel"
chmod 440 "$MNT/etc/sudoers.d/10-wheel"
unset PASS1 PASS2

if [ "$ENCRYPT" = yes ]; then
  step "Setting up drive unlocking at startup"
  LUKS_UUID="$(blkid -s UUID -o value "$ROOTPART")"
  if grep -Eq '^HOOKS=.*\bsystemd\b' "$MNT/etc/mkinitcpio.conf"; then
    sed -i -E '/^HOOKS=/s/\bfilesystems\b/sd-encrypt filesystems/' "$MNT/etc/mkinitcpio.conf"
    CRYPT_ARGS="rd.luks.name=$LUKS_UUID=cryptroot root=/dev/mapper/cryptroot"
  else
    sed -i -E '/^HOOKS=/s/\bfilesystems\b/encrypt filesystems/' "$MNT/etc/mkinitcpio.conf"
    CRYPT_ARGS="cryptdevice=UUID=$LUKS_UUID:cryptroot root=/dev/mapper/cryptroot"
  fi
  sed -i -E "s|^GRUB_CMDLINE_LINUX=\"[^\"]*\"|GRUB_CMDLINE_LINUX=\"$CRYPT_ARGS\"|" "$MNT/etc/default/grub"
fi

step "Installing ReqriumOS"
mkdir -p "$MNT/usr/share"
cp -r "$SRC" "$MNT/usr/share/reqriumos"
REQRIUM_INSTALLER=1 arch-chroot "$MNT" /usr/share/reqriumos/system/reqrium-configure \
  --user "$USERNAME" --extras "$EXTRAS"

# Keyboard layout for the desktop
for f in "$MNT/home/$USERNAME/.config/hypr/hyprland.lua" "$MNT/etc/skel/.config/hypr/hyprland.lua"; do
  sed -i "s/kb_layout = \"[^\"]*\"/kb_layout = \"$KEYMAP\"/" "$f"
done

step "Installing the bootloader"
sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=3/' "$MNT/etc/default/grub"
if [ "$BOOT_MODE" = uefi ]; then
  arch-chroot "$MNT" grub-install --target=x86_64-efi --efi-directory="$EFIDIR" --bootloader-id=ReqriumOS
  # Also install to the fallback path, for firmware that ignores boot entries
  arch-chroot "$MNT" grub-install --target=x86_64-efi --efi-directory="$EFIDIR" --removable
else
  arch-chroot "$MNT" grub-install --target=i386-pc "$DISK"
fi
arch-chroot "$MNT" grub-mkconfig -o /boot/grub/grub.cfg

cp "$LOG" "$MNT/var/log/reqrium-install.log" 2>/dev/null || true
trap - ERR
sync

banner "Installed"
gum style --foreground "$SKY" --bold --margin "0 2" \
  "ReqriumOS is installed on $DISK." \
  "Remove the USB stick, then reboot and log in as $USERNAME." \
  "$( [ "$ENCRYPT" = yes ] && echo "At startup you'll be asked for the drive password first." )"
[ -n "${REQRIUM_AUTO:-}" ] && exit 0
read -rp "  Reboot now? [Y/n] " answer </dev/tty
if [[ ! "$answer" =~ ^[Nn] ]]; then
  umount -R "$MNT" || true
  reboot
fi
